        <script><![CDATA[
function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading) {
        return;
    }

    if (!newValue) {
        g_form.clearValue('manager');
        return;
    }

    var ga = new GlideAjax(
        'x_2052380_licens_0.LicensedSoftwareManagerAjax'
    );

    ga.addParam('sysparm_name', 'getManager');
    ga.addParam('sysparm_user_id', newValue);

    ga.getXMLAnswer(function(answer) {
        if (answer) {
            g_form.setValue('manager', answer);
        } else {
            g_form.clearValue('manager');
            g_form.addErrorMessage(
                'No manager is configured for the selected user, or the lookup failed.'
            );
        }
    });
}
